#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 gl_Position [[position]];
};

vertex main0_out main0(uint gl_VertexIndex [[vertex_id]])
{
    main0_out out = {};
    out.gl_Position = float4((gl_VertexIndex == 1u) ? 3.0 : (-1.0), (gl_VertexIndex == 2u) ? 3.0 : (-1.0), 0.0, 1.0);
    return out;
}

