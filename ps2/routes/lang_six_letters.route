# (build 164) Six letters on the name board in the retranslation (his
# long_names: the party's names are up to six letters, and his default
# for Rolf, Eusis, has five): ROLFIE typed -- the board taking the fifth
# and sixth where the cartridge's stops at four -- then his dream's 1504,
# "My name is ROLFIE. I work as an agent".
start new
language retranslation
wait screen title
wait idle                   # TITLE_WAIT: the finished title
press start

wait screen intro
wait idle                   # NEW GAME / CONTINUE / ERASE GAME
expect script $130B         # "Let me check the backup data."
expect script $1310         # "Data check complete."
press c                     # NEW GAME

wait idle                   # the name board, the lamp on A
expect script $1302         # "What is the name of your character?"
press down                  # J
press right
press right
press right
press right
press right
press right
press right
press right
press c                     # R
press left
press left
press left
press c                     # O
press left
press left
press left
press c                     # L
press up                    # C
press right
press right
press right
press c                     # F
press right
press right
press right
press c                     # I
press left
press left
press left
press left
press c                     # E
press up                    # E wraps to the bottom row, onto RUB
wait ticks 7
shot 01_board               # ROLFIE; FWD DEL END his words
press right                 # END
wait idle
press c                     # END

wait idle
expect script $1304
press c
wait idle                    # the dream: $1501, $1502
press c
wait idle
press c
wait idle                    # $1503
press c
wait idle                    # $1504's first page
expect script $1504
expect text "My name is ROLFIE. I work as an agent"
