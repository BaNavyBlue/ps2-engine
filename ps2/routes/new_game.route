# Power on to the first frame the player has Rolf: the title, NEW GAME,
# the name board (ROLF), the dream, the walk to the tower, the Governor,
# the walk home, Rolf's house, and control on the street.
#
# Every stop in the text is `wait idle` then `press c`; the scenes are
# checked by their scripts and by the screens in between.

start new
wait screen title
wait idle                   # TITLE_WAIT: the finished title
shot 01_title
press start

wait screen intro
wait idle                   # NEW GAME / CONTINUE / ERASE GAME
expect script $130B         # "Let me check the backup data."
expect script $1310         # "Data check complete."
shot 02_select
press c                     # NEW GAME

wait idle                   # the name board, the lamp on A
expect script $1302         # "What is the name of your character?"
press down                  # J
press right
press right
press right
press right
press right
press right
press right
press right
press c                     # R
press left
press left
press left
press c                     # O
press left
press left
press left
press c                     # L
press up                    # C
press right
press right
press right
press c                     # F
press up                    # F wraps to the bottom row, onto RUB
press right                 # END
wait idle
shot 03_name
press c                     # END

wait idle
expect script $1304         # "Well, then, let's begin the game!"
press c

# The dream: nine stops over $1501-$1504.
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
expect script $1501
expect script $1502
expect script $1503
expect script $1504

# Demo_HouseToTower, then the Governor: twelve stops, $1101 running on
# through $1104, then $1105-$1106.
wait screen level
wait screen building
wait idle
shot 04_governor
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
expect script $1101
expect script $1104
expect script $1105
expect script $1106

# Demo_TowerToHouse, then Rolf's house: twelve stops, $0901-$0907, Nei's
# window and art arriving mid-scene.
wait screen level
wait screen building
wait idle
shot 05_house
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
expect script $0901
expect script $0902
expect script $0907

# Outside the house, Nei behind Rolf, the pad live.
wait screen level
wait idle
shot 06_control
walk down 2                 # fails unless Rolf is under the pad
wait step
shot 07_walked
expect screen level
expect no-stderr not ported
