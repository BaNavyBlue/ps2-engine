# (build 164) The battle's lists in the retranslation: battle_tech_next's
# way (Amy's thirteen battle techniques, four pages), his names from
# names.json in his face -- the enemy's box ("Arch Dragon"), the party's
# names, Fight/Tactics and Orders/Retreat -- and the technique list a cell
# wider (his wide_techs: 48 px), so page 4's "Nasaresta" (44 px) is whole:
# its last a in the sixth cell, which the stock list has not got.

start battle 213
language retranslation
party 4 30
wait idle
press down                   # STGY
press c
wait idle
press c                      # ORDR
wait idle
press right
wait ticks 3
press right
wait ticks 3
press right                  # Amy
wait ticks 3
press c
wait idle
press right                  # TECH
wait ticks 3
press c
wait idle
expect menu $66 1            # RES SHU DEBAN FOI, the lamp on RES
expect pixel 17 24 $EEE        # the top of the A of Arch Dragon
shot 01_page_1
press up                     # NEXT
wait ticks 3
expect menu $66 0
press c
wait idle
expect menu $66 1            # GIRES SAR SAK NASAK
shot 02_page_2
press up
wait ticks 3
press c
wait idle
expect menu $66 1            # SASHU NARES SANER GISAR
press up
wait ticks 3
press c
wait idle
expect menu $66 1            # NASAR
expect pixel 130 139 $EEE      # Nasaresta's last a, in the sixth cell
shot 03_page_4
press up
wait ticks 3
press c
wait idle
expect menu $66 1            # 13 is not above 16: page 1 again
shot 04_page_1_again
press up
wait ticks 3
press c
wait idle
press up
wait ticks 3
press c
wait idle
press up
wait ticks 3
press c
wait idle
expect menu $66 1            # page 4
press c                      # NASAR: $C810 + Amy's + 0 + 12, the party
wait idle                    # healed, no one to pick
expect menu $60              # back to FIGHT / STGY
press c                      # FIGHT
wait ticks 900
expect command tech
expect no-stderr not ported
