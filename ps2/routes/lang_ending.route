# (build 163) The ending's pages in the retranslation: frameless text, his
# runs on the font's cleared fill (nothing behind the glyphs, as the stock
# letters have nothing behind them), typed beside each portrait. The way
# there is ending's, in the cartridge's language; the language is chosen
# as the ending screen comes, before its first page types.
start level $64 33 37
party 4 50
outfit Rolf Neimet NeiSword NeiShield NeiArmor -
outfit Nei NeiCrown NeiSlasher NeiSlasher NeiCape -
outfit Rudo Neimet NeiShot NeiShot NeiArmor -
outfit Amy NeiCrown NeiSlasher NeiEmel NeiCape -
wait idle
walk up 4
wait idle
wait ticks 2
wait idle
expect script $1813
press c
wait idle
press c
wait idle
expect menu $1F
press c                      # YES
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
expect menu $1F
press down
press c                      # NO: "Die!"
wait idle
expect script $1818
press c
wait screen battle
expect flag $C747 1
wait idle                    # FIGHT/STGY
enemy-hp 1
press c                      # FIGHT: one hit
limit 60000
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
limit 3000
wait screen level
wait ticks 6
wait idle
expect script $183B
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
expect script $181F
press c
limit 3000
wait idle                    # three steps back, then "{char} wait!"
expect script $1831
expect level $64 33 37
press c
wait idle
press c
wait idle                    # eleven north, then Lutz's warning
expect script $1832
expect music $91
expect level $64 33 26
press c
wait idle                    # seventeen north, then the Earthmen
expect script $1819
expect level $64 33 9
press c
wait idle
press c
wait idle
expect menu $1F
press c                      # YES: we hate you
wait idle
expect script $181A
press c
wait idle
expect script $181C
press c
wait idle
expect script $1833
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
expect menu $1F
press c                      # YES: tell us why
wait idle
expect script $1834
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
expect script $1821
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait ticks 2                 # "The Place of Death" before the white fade
expect music $93
limit 3000
wait screen ending
language retranslation
wait ticks 729
expect script $182A
expect text "We'll make you taste the grief"
shot 01_page1
limit 1000
wait ending page2_text
wait ticks 700
expect script $182B
expect text "I can see the confusion and"
shot 02_page2
limit 6000                   # pages 3-6 and the wipe
wait ending final_days_text
wait ticks 600
expect script $1830
expect text "that will never return,"
shot 03_final_days
