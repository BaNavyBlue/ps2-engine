# Build 97d: the C menu stays shut over the Motavia views after Climatrol.
# The one-shot case 4 (loc_7F14) empties the party's slot, sets 300 frames
# and the event word to $501; LevelScreen keeps the high byte, 5, until
# the next load takes it as case 5. ProcessPlayerMenu's `tst.b
# (event_flags).w` sees the 5 and keeps the menu shut (no window, no
# event: nothing else stops it). Before 97d the port's gate read the save
# block's $C710 byte, which nothing ported writes, and C opened the menu
# over the empty map. The same prefix as climatrol_nei_wins.

start slot 1 routes/saves/climatrol_nei_wins.json
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press b                      # out of Data Memory
wait screen level
wait idle
expect level $3D 48 23
walk down 1
wait idle
press a
wait idle
expect script $180A
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
expect script $180B
press c
wait idle
press c
wait idle
press c
wait idle
expect script $180C
expect script $180D
press c
wait idle
press c
wait idle
press c
wait idle
expect script $180F
expect script $1810
expect menu $1F              # WinID_YesNo2
press c                      # YES
wait idle
expect script $1823
press c
wait screen battle
wait idle                    # FIGHT / STGY, Nei alone
expect party Nei
expect music $93             # formation $100: ThePlaceOfDeath
press c                      # FIGHT, repeated until the fight ends
limit 60000
wait idle
expect script $1211          # victory
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
wait idle
press c
limit 3000
wait screen level
wait idle
expect level $3D 48 24
expect script $1826          # "there's no hope for me"
expect party Nei
expect music $90             # case 1: Power
expect pixel 18 131 $000     # the picture on black (ClearSpriteAndScroll)
press c
wait idle
press c
wait idle
expect script $1827          # "{char} calls Nei's name once again"
expect party Rolf Nei Rudo Anna
expect flag $C737 1
expect music $90             # case 2 queues nothing with Nei alive: Power on
expect pixel 18 131 $000
press c
wait idle
expect script $1825          # "The weather control system is shaking"
expect party Rolf Rudo Anna
press c
wait idle
press c
limit 3000
wait level 0                 # case 4: Motavia from above, no party
wait ticks 30
press c                      # the C menu: shut while the byte is 5
wait ticks 30
expect menu none
shot 01_c_over_motavia
wait level $3D               # case 5 all the same
expect level $3D 48 26
wait level 0                 # case 6: the lake full
wait ticks 30
press c
wait ticks 30
expect menu none
shot 02_c_over_the_lake
wait level $3D
limit 8000
wait idle
expect script $1828
